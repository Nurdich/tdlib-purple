transceiver.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/telegram-tdlib.dir/build.make CMakeFiles/telegram-tdlib.dir/transceiver.cpp.s
.PHONY : transceiver.cpp.s

