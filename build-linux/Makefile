# target to generate assembly for a file
tdlib-purple.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/telegram-tdlib.dir/build.make CMakeFiles/telegram-tdlib.dir/tdlib-purple.cpp.s
.PHONY : tdlib-purple.cpp.s

